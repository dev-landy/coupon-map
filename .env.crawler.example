# CouponMap local crawler settings.
# Copy to `.env.crawler.local` and fill in private values.
# `.env.crawler.local` is gitignored.

PROJECT_DIR=/Users/wonjae/asm/coupon-map-v2

# Android SDK / emulator
ANDROID_HOME=/Users/wonjae/Library/Android/sdk
ADB_PATH=/Users/wonjae/Library/Android/sdk/platform-tools/adb
EMULATOR_PATH=/Users/wonjae/Library/Android/sdk/emulator/emulator
AVD_NAME=Pixel_9

# Optional. Leave blank unless multiple emulators/devices are connected.
ANDROID_SERIAL=

# Stable ADB sources that launchd should crawl in production.
# McDonald's ADB is intentionally excluded from the default set for now.
# These are passed to `npm run crawl:all` and ingest into Supabase by default.
CRAWL_SOURCES=burgerking-kr-adb,kfc-kr-adb

# Optional command override. Keep it as one shell command.
# Add `--dry-run` only when you explicitly want to crawl without writing.
# CRAWLER_COMMAND='npm run crawl:all -- --sources "$CRAWL_SOURCES"'

# Supabase server-only keys. Required for the default non-dry-run ingest.
# Store the service role key only in `.env.crawler.local`; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Operational knobs
BOOT_TIMEOUT_SECONDS=180
EMULATOR_FLAGS="-no-snapshot-save -no-boot-anim"
