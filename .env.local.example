# 쿠폰맵 environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real keys.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to ship to the client when Row Level
# Security is enabled on the database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kakao Maps JavaScript app key. Register the local/production domains in
# Kakao Developers, then paste the JavaScript key here.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Amplitude project API key for browser analytics and retention reports.
AMPLITUDE_API_KEY=

# Optional: set to EU only when the Amplitude project uses the EU data center.
AMPLITUDE_SERVER_ZONE=US

# Server-only Supabase settings for scheduled crawler ingestion.
# Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional default source for manual `npm run ingest` runs.
CRAWL_SOURCE=mcdonalds-kr
